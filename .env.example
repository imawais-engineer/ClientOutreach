# Postgres connection string (Supabase: Project Settings -> Database -> Connection string)
# Use the "Transaction pooler" URI for serverless deployments like Vercel.
# If it contains special characters in the password, percent-encode them.
CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Dashboard login credentials (email + password pair used on /login)
SITE_EMAIL=you@example.com
SITE_PASSWORD=change-me

# Secret your backend agent sends as x-api-secret header on POST /api/leads
API_SECRET=change-me-too

# --- Job discovery engine (job_discovery/) ---
# Dashboard base URL the engine calls. No trailing path.
CLIENT_OUTREACH_API_URL=https://your-deployment.example

# Listing providers. Leave blank to use --dry-run fixtures.
APIFY_TOKEN=
FIRECRAWL_API_KEY=
JOOBLE_API_KEY=

# Optional OpenAI-compatible model. Omit to keep the built-in scoring rubric.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional high-priority alerts. Nothing is sent when these are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
